{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "runtime:check": "node scripts/require-node.mjs",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "npm run runtime:check && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run runtime:check && bash scripts/build-verified.sh",
    "start": "npm run runtime:check && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:unit": "npm run runtime:check && node --test tests/*.test.mjs",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "npm run runtime:check && playwright test",
    "test": "npm run build && npm run test:unit",
    "lint": "npm run runtime:check && bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "npm run runtime:check && bash scripts/sites-env.sh -- tsc --noEmit --incremental false",
    "validate:content": "npm run runtime:check && node scripts/validate-content.mjs",
    "check:freshness": "npm run runtime:check && node scripts/check-freshness.mjs",
    "check:household-mobility": "npm run runtime:check && node scripts/check-household-mobility.mjs",
    "evidence:household-refresh": "npm run runtime:check && node scripts/refresh-household-evidence.mjs --write",
    "evidence:monitor": "npm run runtime:check && node scripts/monitor-evidence.mjs",
    "evidence:evaluate": "npm run runtime:check && node scripts/evaluate-evidence.mjs",
    "snapshot:repo": "npm run runtime:check && node scripts/repository-snapshot.mjs",
    "check:i18n": "npm run runtime:check && node scripts/check-i18n.mjs",
    "route:withdraw": "npm run runtime:check && node scripts/withdraw-route.mjs",
    "check": "npm run validate:content && npm run check:freshness && npm run check:household-mobility && npm run check:i18n && npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:browser:built",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "d3-geo": "3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "topojson-client": "3.1.0",
    "vaul": "^1.1.2",
    "world-atlas": "2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
